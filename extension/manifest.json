{
  "manifest_version": 3,
  "name": "Fluffinator",
  "version": "1.0.0",
  "description": "Turn a curt message into something kind, clear, and polished.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Fluffinator"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://api.fluffinator.io/*",
    "https://cognito-idp.us-east-1.amazonaws.com/*"
  ],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
